from snowflake.snowpark.context import get_active_session

session = get_active_session()

# Configuration
target_db = "DEV_DB"
target_schema = "STAGING"
dev_role = "DEV_USER_ROLE"
ro_role = "RO_USER_ROLE"

try:
    # 1. Create Roles if they don't exist
    print(f"Creating Roles: {dev_role}, {ro_role}...")
    session.sql(f"CREATE ROLE IF NOT EXISTS {dev_role}").collect()
    session.sql(f"CREATE ROLE IF NOT EXISTS {ro_role}").collect()

    # 2. Create Database
    print(f"Creating Database: {target_db}...")
    session.sql(f"CREATE DATABASE IF NOT EXISTS {target_db}").collect()

    # 3. Create Schema
    print(f"Creating Schema: {target_db}.{target_schema}...")
    session.sql(f"CREATE SCHEMA IF NOT EXISTS {target_db}.{target_schema}").collect()

    # 4. Applying security model
    print("Applying security model...")
    sql_commands = [
        # Developer Role Grants
        f"GRANT USAGE ON DATABASE {target_db} TO ROLE {dev_role}",
        f"GRANT ALL PRIVILEGES ON SCHEMA {target_db}.{target_schema} TO ROLE {dev_role}",
        f"GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA {target_db}.{target_schema} TO ROLE {dev_role}",
        f"GRANT ALL PRIVILEGES ON FUTURE TABLES IN SCHEMA {target_db}.{target_schema} TO ROLE {dev_role}",
        
        # Read-Only Role Grants
        f"GRANT USAGE ON DATABASE {target_db} TO ROLE {ro_role}",
        f"GRANT USAGE ON SCHEMA {target_db}.{target_schema} TO ROLE {ro_role}",
        f"GRANT SELECT ON ALL TABLES IN SCHEMA {target_db}.{target_schema} TO ROLE {ro_role}",
        f"GRANT SELECT ON ALL VIEWS IN SCHEMA {target_db}.{target_schema} TO ROLE {ro_role}",
        f"GRANT SELECT ON FUTURE TABLES IN SCHEMA {target_db}.{target_schema} TO ROLE {ro_role}"
    ]

    for cmd in sql_commands:
        session.sql(cmd).collect()

    print(f"Success! Database {target_db}, Schema {target_schema}, and Roles are ready!")

except Exception as e:
    print(f"Error: {str(e)}")
